# Local demo: explicitly opt into synthetic reviewer identity; never enable in cloud.
TRUESTATE_MODE=demo
TRUESTATE_LOCAL_DEMO_AUTH=1
DATABASE_URL=sqlite:///./truestate.db
# Mount a durable volume here when deploying the portable backend.
TRUESTATE_UPLOAD_DIR=./.private-evidence
# Alternatively map strong bearer secrets to server-owned user IDs and roles:
# TRUESTATE_API_TOKENS={"replace-with-long-random-secret":{"user_id":"operator-1","role":"reviewer"}}
# Google Cloud mode requires PostgreSQL plus explicit credentials via ADC.
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=
AGENT_SEARCH_LOCATION=global
AGENT_SEARCH_ENGINE_ID=
BIGQUERY_TABLE=
PUBSUB_TOPIC=
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT=
PUBSUB_TENANT_ID=
GCS_BUCKET=
